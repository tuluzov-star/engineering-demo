    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "@axe-core/playwright": "4.13.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.0"
  }
